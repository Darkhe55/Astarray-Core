{
  "name": "astarray",
  "version": "0.1.0",
  "description": "TUI agent orchestration tool with Ponder / Assist / Devolve modes",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "astarray": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/public-sdk.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test",
    "check:low-parallel": "npm run typecheck && npm run lint && npm run build && vitest run --maxWorkers=2",
    "prepack": "npm run check",
    "verify:sdk-consumer": "node scripts/verify-sdk-consumer.mjs",
    "verify:e2e01": "node scripts/e2e01-acceptance.mjs fixture",
    "verify:e2e01-03-harness": "node scripts/verify-e2e01-03-concurrency-harness.mjs --allow-live-request --permission-decision allow-once --mode devolve",
    "verify:security-coverage": "node scripts/verify-security-coverage.mjs",
    "verify:mutation-kills": "node scripts/verify-mutation-kills.mjs",
    "verify:read-format-package": "node scripts/verify-read-format-package.mjs",
    "verify:entry-runtime-selection": "node scripts/verify-entry-runtime-selection.mjs",
    "verify:provider-tool-protocol": "node scripts/verify-provider-tool-protocol.mjs",
    "verify:provider-live-request": "node scripts/verify-provider-request-against-endpoint.mjs",
    "verify:t07d-r2-04-live": "node scripts/verify-t07d-r2-04-live-write.mjs",
    "verify:t07d-r2-04-dry": "node scripts/verify-t07d-r2-04-live-dry-run.mjs",
    "verify:t07d-r2-04-tarball-dry": "node scripts/verify-t07d-r2-04-tarball-live.mjs --dry-run",
    "verify:t07d-r2-04-tarball-live": "node scripts/verify-t07d-r2-04-tarball-live.mjs --allow-live-request",
    "verify:observability-entry-package": "node scripts/verify-observability-entry-package.mjs",
    "verify:instruction-entry-package": "node scripts/verify-instruction-entry-package.mjs",
    "verify:toolkit-package": "node scripts/verify-toolkit-package.mjs",
    "verify:u2-flash-probe": "node scripts/verify-u2-flash-continuous-reception.mjs --probe-only",
    "verify:u2-flash-continuous-reception": "node scripts/verify-u2-flash-continuous-reception.mjs",
    "test:scripts": "node --test \"scripts/lib/*.test.mjs\"",
    "verify:contract-sdk": "node scripts/verify-contract-sdk-package.mjs",
    "verify:relocation-batch": "node scripts/verify-relocation-batch-sample.mjs",
    "verify:docview-measurement": "node scripts/verify-docview-measurement.mjs --package-dir .tmp/docview-measurement-package/node_modules/astarray",
    "verify:history-measurement": "npx tsx scripts/verify-history-measurement.mjs",
    "verify:perf-overview-package": "node scripts/verify-perf-overview-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:project-pressure-package": "node scripts/verify-project-pressure-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:diagnostic-package": "node scripts/verify-diagnostic-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:guidance-package": "node scripts/verify-guidance-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:usage-package": "node scripts/verify-usage-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:accuracy-package": "node scripts/verify-accuracy-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:accuracy-settings-package": "node scripts/verify-accuracy-settings-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:accuracy-e2e-package": "node scripts/verify-accuracy-e2e-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:comm-package": "node scripts/verify-comm-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:secretary-package": "node scripts/verify-secretary-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:onboarding-package": "node scripts/verify-onboarding-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:cli-json-package": "node scripts/verify-cli-json-package.mjs --package-dir .tmp/perf-pkg/node_modules/astarray",
    "verify:summary-annotation": "npx tsx scripts/verify-summary-annotation.mjs --samples docs/reports/SUM02_04_ANNOTATION_TEMPLATE.jsonl",
    "verify:event01-criteria": "npx tsx scripts/verify-event01-criteria.mjs --criteria docs/reports/EVENT01_ACCEPTANCE_CRITERIA_TEMPLATE.json --allow-incomplete",
    "verify:event01-package": "node scripts/verify-event01-package.mjs --package-dir .tmp/comm-install/node_modules/astarray"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "fast-check": "^4.9.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
